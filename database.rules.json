{
  "rules": {
    "rooms": {
      "$room": {
        ".read": "auth != null",
        ".write": "auth != null && ((!data.exists() && newData.exists() && newData.child('participants').hasChild(auth.uid) && newData.child('participants').numChildren() <= 2) || (data.exists() && data.child('hostUid').val() == auth.uid) || (data.exists() && data.child('hostUid').val() == null && newData.child('hostUid').val() == auth.uid) || (data.exists() && root.child('privateChoices').child($room).numChildren() == 2 && newData.child('phase').val() == 'result'))",
        "participants": {
          "$uid": {
            ".write": "auth != null && auth.uid == $uid && root.child('rooms').child($room).exists() && ((!data.exists() && root.child('rooms').child($room).child('phase').val() == 'waiting' && root.child('rooms').child($room).child('participants').numChildren() < 2) || data.exists())",
            ".validate": "newData.hasChildren(['role','joinedAt','mediaReady']) && newData.child('role').val() == 'date'"
          }
        },
        "chat": {
          "$id": {
            ".write": "auth != null && newData.child('uid').val() == auth.uid && newData.child('text').isString() && newData.child('text').val().length <= 500"
          }
        },
        "signals": {
          "$id": {
            ".write": "auth != null && newData.child('from').val() == auth.uid"
          }
        }
      }
    },
    "privateRatings": {
      "$room": {
        ".read": "auth != null && (root.child('rooms').child($room).child('hostUid').val() == auth.uid || root.child('rooms').child($room).child('phase').val() == 'result')",
        "$round": {
          "$uid": {
            ".read": "auth != null && (auth.uid == $uid || root.child('rooms').child($room).child('hostUid').val() == auth.uid || root.child('rooms').child($room).child('phase').val() == 'result')",
            ".write": "auth != null && auth.uid == $uid && root.child('rooms').child($room).child('phase').val() == 'rating'",
            ".validate": "newData.hasChildren(['rating','comment','at']) && newData.child('rating').isNumber() && (newData.child('rating').val() == -100 || newData.child('rating').val() == 0 || (newData.child('rating').val() >= 1 && newData.child('rating').val() <= 10))"
          }
        }
      }
    },
    "privateChoices": {
      "$room": {
        ".read": "auth != null && (root.child('rooms').child($room).child('hostUid').val() == auth.uid || root.child('rooms').child($room).child('phase').val() == 'result')",
        "$uid": {
          ".read": "auth != null && (auth.uid == $uid || root.child('rooms').child($room).child('hostUid').val() == auth.uid || root.child('rooms').child($room).child('phase').val() == 'result')",
          ".write": "auth != null && auth.uid == $uid && root.child('rooms').child($room).child('phase').val() == 'final'",
          ".validate": "newData.val() == 'yes' || newData.val() == 'no'"
        }
      }
    }
  }
}
